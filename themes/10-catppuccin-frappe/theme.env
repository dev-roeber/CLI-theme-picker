THEME_NAME="catppuccin-frappe"
THEME_RANK="10"
THEME_BG="#303446"
THEME_FG="#c6d0f5"
THEME_ACCENT="#ca9ee6"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#c6d0f5\007"  # foreground
  printf "\033]11;#303446\007"  # background
  printf "\033]12;#ca9ee6\007" # cursor
fi
# <<< theme-picker osc <<<
