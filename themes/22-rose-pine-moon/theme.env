THEME_NAME="rose-pine-moon"
THEME_RANK="22"
THEME_BG="#232136"
THEME_FG="#e0def4"
THEME_ACCENT="#ea9a97"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#e0def4\007"  # foreground
  printf "\033]11;#232136\007"  # background
  printf "\033]12;#ea9a97\007" # cursor
fi
# <<< theme-picker osc <<<
