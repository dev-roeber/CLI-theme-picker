THEME_NAME="rose-pine-moon"
THEME_RANK="22"
THEME_BG="#232136"
THEME_FG="#e0def4"
THEME_ACCENT="#ea9a97"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor + ANSI 16 colors via OSC.
# Honored by: iTerm2, Ghostty, kitty, alacritty, WezTerm, recent
# Terminal.app, gnome-terminal. Disable with THEME_PICKER_NO_OSC=1.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#e0def4\007"  # foreground
  printf "\033]11;#232136\007"  # background
  printf "\033]12;#ea9a97\007" # cursor
  printf "\033]4;0;#393552\007"
  printf "\033]4;1;#eb6f92\007"
  printf "\033]4;2;#3e8fb0\007"
  printf "\033]4;3;#f6c177\007"
  printf "\033]4;4;#9ccfd8\007"
  printf "\033]4;5;#c4a7e7\007"
  printf "\033]4;6;#ea9a97\007"
  printf "\033]4;7;#e0def4\007"
  printf "\033]4;8;#6e6a86\007"
  printf "\033]4;9;#eb6f92\007"
  printf "\033]4;10;#3e8fb0\007"
  printf "\033]4;11;#f6c177\007"
  printf "\033]4;12;#9ccfd8\007"
  printf "\033]4;13;#c4a7e7\007"
  printf "\033]4;14;#ea9a97\007"
  printf "\033]4;15;#e0def4\007"
fi
# <<< theme-picker osc <<<
