THEME_NAME="59-synthwave-84"
THEME_RANK="59"
THEME_BG="#241b2f"
THEME_FG="#f7f7ff"
THEME_ACCENT="#ff7edb"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#f7f7ff\007"  # foreground
  printf "\033]11;#241b2f\007"  # background
  printf "\033]12;#ff7edb\007" # cursor
fi
# <<< theme-picker osc <<<
