THEME_NAME="59-synthwave-84"
THEME_RANK="59"
THEME_BG="#241b2f"
THEME_FG="#f7f7ff"
THEME_ACCENT="#ff7edb"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor + ANSI 16 colors via OSC.
# Honored by: iTerm2, Ghostty, kitty, alacritty, WezTerm, recent
# Terminal.app, gnome-terminal. Disable with THEME_PICKER_NO_OSC=1.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#f7f7ff\007"  # foreground
  printf "\033]11;#241b2f\007"  # background
  printf "\033]12;#ff7edb\007" # cursor
  printf "\033]4;0;#000000\007"
  printf "\033]4;1;#fe4450\007"
  printf "\033]4;2;#72f1b8\007"
  printf "\033]4;3;#fede5d\007"
  printf "\033]4;4;#03edf9\007"
  printf "\033]4;5;#ff7edb\007"
  printf "\033]4;6;#03edf9\007"
  printf "\033]4;7;#f7f7ff\007"
  printf "\033]4;8;#495495\007"
  printf "\033]4;9;#fe4450\007"
  printf "\033]4;10;#72f1b8\007"
  printf "\033]4;11;#fede5d\007"
  printf "\033]4;12;#03edf9\007"
  printf "\033]4;13;#ff7edb\007"
  printf "\033]4;14;#03edf9\007"
  printf "\033]4;15;#f7f7ff\007"
fi
# <<< theme-picker osc <<<
