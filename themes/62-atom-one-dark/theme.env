THEME_NAME="62-atom-one-dark"
THEME_RANK="62"
THEME_BG="#282c34"
THEME_FG="#abb2bf"
THEME_ACCENT="#61afef"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#abb2bf\007"  # foreground
  printf "\033]11;#282c34\007"  # background
  printf "\033]12;#61afef\007" # cursor
fi
# <<< theme-picker osc <<<
