THEME_NAME="62-atom-one-dark"
THEME_RANK="62"
THEME_BG="#282c34"
THEME_FG="#abb2bf"
THEME_ACCENT="#61afef"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor + ANSI 16 colors via OSC.
# Honored by: iTerm2, Ghostty, kitty, alacritty, WezTerm, recent
# Terminal.app, gnome-terminal. Disable with THEME_PICKER_NO_OSC=1.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#abb2bf\007"  # foreground
  printf "\033]11;#282c34\007"  # background
  printf "\033]12;#61afef\007" # cursor
  printf "\033]4;0;#000000\007"
  printf "\033]4;1;#e06c75\007"
  printf "\033]4;2;#98c379\007"
  printf "\033]4;3;#d19a66\007"
  printf "\033]4;4;#61afef\007"
  printf "\033]4;5;#c678dd\007"
  printf "\033]4;6;#56b6c2\007"
  printf "\033]4;7;#abb2bf\007"
  printf "\033]4;8;#5c6370\007"
  printf "\033]4;9;#e06c75\007"
  printf "\033]4;10;#98c379\007"
  printf "\033]4;11;#d19a66\007"
  printf "\033]4;12;#61afef\007"
  printf "\033]4;13;#c678dd\007"
  printf "\033]4;14;#56b6c2\007"
  printf "\033]4;15;#ffffff\007"
fi
# <<< theme-picker osc <<<
