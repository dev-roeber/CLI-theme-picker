THEME_NAME="74-tomorrow-night"
THEME_RANK="74"
THEME_BG="#1d1f21"
THEME_FG="#c5c8c6"
THEME_ACCENT="#b294bb"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#c5c8c6\007"  # foreground
  printf "\033]11;#1d1f21\007"  # background
  printf "\033]12;#b294bb\007" # cursor
fi
# <<< theme-picker osc <<<
