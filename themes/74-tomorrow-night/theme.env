THEME_NAME="74-tomorrow-night"
THEME_RANK="74"
THEME_BG="#1d1f21"
THEME_FG="#c5c8c6"
THEME_ACCENT="#b294bb"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor + ANSI 16 colors via OSC.
# Honored by: iTerm2, Ghostty, kitty, alacritty, WezTerm, recent
# Terminal.app, gnome-terminal. Disable with THEME_PICKER_NO_OSC=1.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#c5c8c6\007"  # foreground
  printf "\033]11;#1d1f21\007"  # background
  printf "\033]12;#b294bb\007" # cursor
  printf "\033]4;0;#000000\007"
  printf "\033]4;1;#cc6666\007"
  printf "\033]4;2;#b5bd68\007"
  printf "\033]4;3;#f0c674\007"
  printf "\033]4;4;#81a2be\007"
  printf "\033]4;5;#b294bb\007"
  printf "\033]4;6;#8abeb7\007"
  printf "\033]4;7;#c5c8c6\007"
  printf "\033]4;8;#666666\007"
  printf "\033]4;9;#d54e53\007"
  printf "\033]4;10;#b9ca4a\007"
  printf "\033]4;11;#e7c547\007"
  printf "\033]4;12;#7aa6da\007"
  printf "\033]4;13;#c397d8\007"
  printf "\033]4;14;#70c0b1\007"
  printf "\033]4;15;#eaeaea\007"
fi
# <<< theme-picker osc <<<
