THEME_NAME="96-hopscotch"
THEME_RANK="96"
THEME_BG="#322931"
THEME_FG="#b9b5b8"
THEME_ACCENT="#fd8b19"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#b9b5b8\007"  # foreground
  printf "\033]11;#322931\007"  # background
  printf "\033]12;#fd8b19\007" # cursor
fi
# <<< theme-picker osc <<<
