THEME_NAME="nord"
THEME_RANK="06"
THEME_BG="#2e3440"
THEME_FG="#d8dee9"
THEME_ACCENT="#5e81ac"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor + ANSI 16 colors via OSC.
# Honored by: iTerm2, Ghostty, kitty, alacritty, WezTerm, recent
# Terminal.app, gnome-terminal. Disable with THEME_PICKER_NO_OSC=1.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#d8dee9\007"  # foreground
  printf "\033]11;#2e3440\007"  # background
  printf "\033]12;#5e81ac\007" # cursor
  printf "\033]4;0;#3b4252\007"
  printf "\033]4;1;#bf616a\007"
  printf "\033]4;2;#a3be8c\007"
  printf "\033]4;3;#ebcb8b\007"
  printf "\033]4;4;#81a1c1\007"
  printf "\033]4;5;#b48ead\007"
  printf "\033]4;6;#88c0d0\007"
  printf "\033]4;7;#e5e9f0\007"
  printf "\033]4;8;#4c566a\007"
  printf "\033]4;9;#bf616a\007"
  printf "\033]4;10;#a3be8c\007"
  printf "\033]4;11;#ebcb8b\007"
  printf "\033]4;12;#81a1c1\007"
  printf "\033]4;13;#b48ead\007"
  printf "\033]4;14;#8fbcbb\007"
  printf "\033]4;15;#eceff4\007"
fi
# <<< theme-picker osc <<<
