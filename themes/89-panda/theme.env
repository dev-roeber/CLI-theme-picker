THEME_NAME="89-panda"
THEME_RANK="89"
THEME_BG="#292a2b"
THEME_FG="#e6e6e6"
THEME_ACCENT="#ff75b5"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#e6e6e6\007"  # foreground
  printf "\033]11;#292a2b\007"  # background
  printf "\033]12;#ff75b5\007" # cursor
fi
# <<< theme-picker osc <<<
