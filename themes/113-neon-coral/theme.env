THEME_NAME="113-neon-coral"
THEME_RANK="113"
THEME_BG="#140505"
THEME_FG="#ff6f61"
THEME_ACCENT="#ff7f50"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#ff6f61\007"  # foreground
  printf "\033]11;#140505\007"  # background
  printf "\033]12;#ff7f50\007" # cursor
fi
# <<< theme-picker osc <<<
