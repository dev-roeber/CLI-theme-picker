THEME_NAME="98-deep-sea"
THEME_RANK="98"
THEME_BG="#0a192f"
THEME_FG="#8892b0"
THEME_ACCENT="#64ffda"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#8892b0\007"  # foreground
  printf "\033]11;#0a192f\007"  # background
  printf "\033]12;#64ffda\007" # cursor
fi
# <<< theme-picker osc <<<
