THEME_NAME="52-solarized-dark"
THEME_RANK="52"
THEME_BG="#002b36"
THEME_FG="#839496"
THEME_ACCENT="#268bd2"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor + ANSI 16 colors via OSC.
# Honored by: iTerm2, Ghostty, kitty, alacritty, WezTerm, recent
# Terminal.app, gnome-terminal. Disable with THEME_PICKER_NO_OSC=1.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#839496\007"  # foreground
  printf "\033]11;#002b36\007"  # background
  printf "\033]12;#268bd2\007" # cursor
  printf "\033]4;0;#073642\007"
  printf "\033]4;1;#dc322f\007"
  printf "\033]4;2;#859900\007"
  printf "\033]4;3;#b58900\007"
  printf "\033]4;4;#268bd2\007"
  printf "\033]4;5;#d33682\007"
  printf "\033]4;6;#2aa198\007"
  printf "\033]4;7;#eee8d5\007"
  printf "\033]4;8;#002b36\007"
  printf "\033]4;9;#cb4b16\007"
  printf "\033]4;10;#586e75\007"
  printf "\033]4;11;#657b83\007"
  printf "\033]4;12;#839496\007"
  printf "\033]4;13;#6c71c4\007"
  printf "\033]4;14;#93a1a1\007"
  printf "\033]4;15;#fdf6e3\007"
fi
# <<< theme-picker osc <<<
