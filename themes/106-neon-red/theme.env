THEME_NAME="106-neon-red"
THEME_RANK="106"
THEME_BG="#140000"
THEME_FG="#ff073a"
THEME_ACCENT="#ff0000"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#ff073a\007"  # foreground
  printf "\033]11;#140000\007"  # background
  printf "\033]12;#ff0000\007" # cursor
fi
# <<< theme-picker osc <<<
