THEME_NAME="104-neon-yellow"
THEME_RANK="104"
THEME_BG="#141400"
THEME_FG="#fff700"
THEME_ACCENT="#ffff00"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#fff700\007"  # foreground
  printf "\033]11;#141400\007"  # background
  printf "\033]12;#ffff00\007" # cursor
fi
# <<< theme-picker osc <<<
