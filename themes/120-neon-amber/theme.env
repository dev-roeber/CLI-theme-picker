THEME_NAME="120-neon-amber"
THEME_RANK="120"
THEME_BG="#140800"
THEME_FG="#ff8c00"
THEME_ACCENT="#ffbf00"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#ff8c00\007"  # foreground
  printf "\033]11;#140800\007"  # background
  printf "\033]12;#ffbf00\007" # cursor
fi
# <<< theme-picker osc <<<
