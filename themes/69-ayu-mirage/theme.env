THEME_NAME="69-ayu-mirage"
THEME_RANK="69"
THEME_BG="#1f2430"
THEME_FG="#cbccc6"
THEME_ACCENT="#ffcc66"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#cbccc6\007"  # foreground
  printf "\033]11;#1f2430\007"  # background
  printf "\033]12;#ffcc66\007" # cursor
fi
# <<< theme-picker osc <<<
