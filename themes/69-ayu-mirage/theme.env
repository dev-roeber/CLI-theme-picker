THEME_NAME="69-ayu-mirage"
THEME_RANK="69"
THEME_BG="#1f2430"
THEME_FG="#cbccc6"
THEME_ACCENT="#ffcc66"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor + ANSI 16 colors via OSC.
# Honored by: iTerm2, Ghostty, kitty, alacritty, WezTerm, recent
# Terminal.app, gnome-terminal. Disable with THEME_PICKER_NO_OSC=1.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#cbccc6\007"  # foreground
  printf "\033]11;#1f2430\007"  # background
  printf "\033]12;#ffcc66\007" # cursor
  printf "\033]4;0;#0f1419\007"
  printf "\033]4;1;#f28779\007"
  printf "\033]4;2;#d5ff80\007"
  printf "\033]4;3;#ffd173\007"
  printf "\033]4;4;#73d0ff\007"
  printf "\033]4;5;#dfbfff\007"
  printf "\033]4;6;#95e6cb\007"
  printf "\033]4;7;#cbccc6\007"
  printf "\033]4;8;#1a1f29\007"
  printf "\033]4;9;#f29e74\007"
  printf "\033]4;10;#d5ff80\007"
  printf "\033]4;11;#ffd173\007"
  printf "\033]4;12;#73d0ff\007"
  printf "\033]4;13;#dfbfff\007"
  printf "\033]4;14;#95e6cb\007"
  printf "\033]4;15;#ffffff\007"
fi
# <<< theme-picker osc <<<
