THEME_NAME="102-neon-cyan"
THEME_RANK="102"
THEME_BG="#001414"
THEME_FG="#00ffff"
THEME_ACCENT="#00f5ff"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#00ffff\007"  # foreground
  printf "\033]11;#001414\007"  # background
  printf "\033]12;#00f5ff\007" # cursor
fi
# <<< theme-picker osc <<<
