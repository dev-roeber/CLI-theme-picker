THEME_NAME="78-iceberg-dark"
THEME_RANK="78"
THEME_BG="#161821"
THEME_FG="#c6c8d1"
THEME_ACCENT="#84a0c6"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#c6c8d1\007"  # foreground
  printf "\033]11;#161821\007"  # background
  printf "\033]12;#84a0c6\007" # cursor
fi
# <<< theme-picker osc <<<
