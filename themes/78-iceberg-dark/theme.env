THEME_NAME="78-iceberg-dark"
THEME_RANK="78"
THEME_BG="#161821"
THEME_FG="#c6c8d1"
THEME_ACCENT="#84a0c6"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor + ANSI 16 colors via OSC.
# Honored by: iTerm2, Ghostty, kitty, alacritty, WezTerm, recent
# Terminal.app, gnome-terminal. Disable with THEME_PICKER_NO_OSC=1.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#c6c8d1\007"  # foreground
  printf "\033]11;#161821\007"  # background
  printf "\033]12;#84a0c6\007" # cursor
  printf "\033]4;0;#161821\007"
  printf "\033]4;1;#e27878\007"
  printf "\033]4;2;#b4be82\007"
  printf "\033]4;3;#e2a478\007"
  printf "\033]4;4;#84a0c6\007"
  printf "\033]4;5;#a093c7\007"
  printf "\033]4;6;#89b8c2\007"
  printf "\033]4;7;#c6c8d1\007"
  printf "\033]4;8;#6b7089\007"
  printf "\033]4;9;#e98989\007"
  printf "\033]4;10;#c0ca8e\007"
  printf "\033]4;11;#e9b189\007"
  printf "\033]4;12;#91acd1\007"
  printf "\033]4;13;#ada0d3\007"
  printf "\033]4;14;#95c4ce\007"
  printf "\033]4;15;#d2d4de\007"
fi
# <<< theme-picker osc <<<
