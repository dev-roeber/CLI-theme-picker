THEME_NAME="82-zenburn"
THEME_RANK="82"
THEME_BG="#3f3f3f"
THEME_FG="#dcdccc"
THEME_ACCENT="#dca3a3"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#dcdccc\007"  # foreground
  printf "\033]11;#3f3f3f\007"  # background
  printf "\033]12;#dca3a3\007" # cursor
fi
# <<< theme-picker osc <<<
