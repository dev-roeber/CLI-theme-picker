THEME_NAME="76-tomorrow-night-bright"
THEME_RANK="76"
THEME_BG="#000000"
THEME_FG="#eaeaea"
THEME_ACCENT="#7aa6da"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#eaeaea\007"  # foreground
  printf "\033]11;#000000\007"  # background
  printf "\033]12;#7aa6da\007" # cursor
fi
# <<< theme-picker osc <<<
