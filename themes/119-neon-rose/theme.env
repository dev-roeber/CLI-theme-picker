THEME_NAME="119-neon-rose"
THEME_RANK="119"
THEME_BG="#14000a"
THEME_FG="#ff007f"
THEME_ACCENT="#ff66cc"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#ff007f\007"  # foreground
  printf "\033]11;#14000a\007"  # background
  printf "\033]12;#ff66cc\007" # cursor
fi
# <<< theme-picker osc <<<
