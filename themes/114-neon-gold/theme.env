THEME_NAME="114-neon-gold"
THEME_RANK="114"
THEME_BG="#141200"
THEME_FG="#ffc107"
THEME_ACCENT="#ffd700"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#ffc107\007"  # foreground
  printf "\033]11;#141200\007"  # background
  printf "\033]12;#ffd700\007" # cursor
fi
# <<< theme-picker osc <<<
