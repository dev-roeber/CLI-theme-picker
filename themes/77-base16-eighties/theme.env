THEME_NAME="77-base16-eighties"
THEME_RANK="77"
THEME_BG="#2d2d2d"
THEME_FG="#d3d0c8"
THEME_ACCENT="#6699cc"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#d3d0c8\007"  # foreground
  printf "\033]11;#2d2d2d\007"  # background
  printf "\033]12;#6699cc\007" # cursor
fi
# <<< theme-picker osc <<<
