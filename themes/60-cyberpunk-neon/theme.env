THEME_NAME="60-cyberpunk-neon"
THEME_RANK="60"
THEME_BG="#000b1e"
THEME_FG="#0abdc6"
THEME_ACCENT="#ea00d9"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#0abdc6\007"  # foreground
  printf "\033]11;#000b1e\007"  # background
  printf "\033]12;#ea00d9\007" # cursor
fi
# <<< theme-picker osc <<<
