THEME_NAME="73-kanagawa-lotus"
THEME_RANK="73"
THEME_BG="#f2ecbc"
THEME_FG="#545464"
THEME_ACCENT="#4d699b"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#545464\007"  # foreground
  printf "\033]11;#f2ecbc\007"  # background
  printf "\033]12;#4d699b\007" # cursor
fi
# <<< theme-picker osc <<<
