THEME_NAME="90-snazzy"
THEME_RANK="90"
THEME_BG="#1e1f29"
THEME_FG="#eff0eb"
THEME_ACCENT="#ff6ac1"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor + ANSI 16 colors via OSC.
# Honored by: iTerm2, Ghostty, kitty, alacritty, WezTerm, recent
# Terminal.app, gnome-terminal. Disable with THEME_PICKER_NO_OSC=1.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#eff0eb\007"  # foreground
  printf "\033]11;#1e1f29\007"  # background
  printf "\033]12;#ff6ac1\007" # cursor
  printf "\033]4;0;#000000\007"
  printf "\033]4;1;#fc4346\007"
  printf "\033]4;2;#50fb7c\007"
  printf "\033]4;3;#f0fb8c\007"
  printf "\033]4;4;#49baff\007"
  printf "\033]4;5;#fc4cb4\007"
  printf "\033]4;6;#8be9fe\007"
  printf "\033]4;7;#ededec\007"
  printf "\033]4;8;#555555\007"
  printf "\033]4;9;#fc4346\007"
  printf "\033]4;10;#50fb7c\007"
  printf "\033]4;11;#f0fb8c\007"
  printf "\033]4;12;#49baff\007"
  printf "\033]4;13;#fc4cb4\007"
  printf "\033]4;14;#8be9fe\007"
  printf "\033]4;15;#ededec\007"
fi
# <<< theme-picker osc <<<
