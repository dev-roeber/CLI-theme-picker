THEME_NAME="90-snazzy"
THEME_RANK="90"
THEME_BG="#1e1f29"
THEME_FG="#eff0eb"
THEME_ACCENT="#ff6ac1"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#eff0eb\007"  # foreground
  printf "\033]11;#1e1f29\007"  # background
  printf "\033]12;#ff6ac1\007" # cursor
fi
# <<< theme-picker osc <<<
