THEME_NAME="93-bluloco-light"
THEME_RANK="93"
THEME_BG="#f9f9f9"
THEME_FG="#383a42"
THEME_ACCENT="#0098dd"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#383a42\007"  # foreground
  printf "\033]11;#f9f9f9\007"  # background
  printf "\033]12;#0098dd\007" # cursor
fi
# <<< theme-picker osc <<<
