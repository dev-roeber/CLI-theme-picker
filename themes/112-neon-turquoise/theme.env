THEME_NAME="112-neon-turquoise"
THEME_RANK="112"
THEME_BG="#001414"
THEME_FG="#00ced1"
THEME_ACCENT="#40e0d0"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#00ced1\007"  # foreground
  printf "\033]11;#001414\007"  # background
  printf "\033]12;#40e0d0\007" # cursor
fi
# <<< theme-picker osc <<<
