# delta theme — included via [include] path = ~/.config/theme-picker/active/delta.gitconfig
[delta]
  syntax-theme = OneHalfLight
  line-numbers = true
  navigate = true
  side-by-side = false
  file-style = "#ff9940 bold"
  hunk-header-decoration-style = "#ff9940 ul"
  file-decoration-style = "#ff9940"
  minus-style = "syntax #f0533a33"
  minus-emph-style = "syntax #f0533a55"
  plus-style = "syntax #5e970033"
  plus-emph-style = "syntax #5e970055"
  zero-style = "syntax"
  whitespace-error-style = "#f0533a reverse"
