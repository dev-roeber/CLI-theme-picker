THEME_NAME="70-ayu-light"
THEME_RANK="70"
THEME_BG="#fafafa"
THEME_FG="#5c6773"
THEME_ACCENT="#ff9940"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor + ANSI 16 colors via OSC.
# Honored by: iTerm2, Ghostty, kitty, alacritty, WezTerm, recent
# Terminal.app, gnome-terminal. Disable with THEME_PICKER_NO_OSC=1.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#5c6773\007"  # foreground
  printf "\033]11;#fafafa\007"  # background
  printf "\033]12;#ff9940\007" # cursor
  printf "\033]4;0;#000000\007"
  printf "\033]4;1;#f0533a\007"
  printf "\033]4;2;#5e9700\007"
  printf "\033]4;3;#f29718\007"
  printf "\033]4;4;#41a6d9\007"
  printf "\033]4;5;#9d57d3\007"
  printf "\033]4;6;#4dbf99\007"
  printf "\033]4;7;#5c6773\007"
  printf "\033]4;8;#828c99\007"
  printf "\033]4;9;#f0533a\007"
  printf "\033]4;10;#5e9700\007"
  printf "\033]4;11;#f29718\007"
  printf "\033]4;12;#41a6d9\007"
  printf "\033]4;13;#9d57d3\007"
  printf "\033]4;14;#4dbf99\007"
  printf "\033]4;15;#000000\007"
fi
# <<< theme-picker osc <<<
