THEME_NAME="70-ayu-light"
THEME_RANK="70"
THEME_BG="#fafafa"
THEME_FG="#5c6773"
THEME_ACCENT="#ff9940"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#5c6773\007"  # foreground
  printf "\033]11;#fafafa\007"  # background
  printf "\033]12;#ff9940\007" # cursor
fi
# <<< theme-picker osc <<<
