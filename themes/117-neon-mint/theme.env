THEME_NAME="117-neon-mint"
THEME_RANK="117"
THEME_BG="#001410"
THEME_FG="#00ffaa"
THEME_ACCENT="#3eb489"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#00ffaa\007"  # foreground
  printf "\033]11;#001410\007"  # background
  printf "\033]12;#3eb489\007" # cursor
fi
# <<< theme-picker osc <<<
