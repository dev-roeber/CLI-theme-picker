THEME_NAME="79-iceberg-light"
THEME_RANK="79"
THEME_BG="#e8e9ec"
THEME_FG="#33374c"
THEME_ACCENT="#2d539e"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#33374c\007"  # foreground
  printf "\033]11;#e8e9ec\007"  # background
  printf "\033]12;#2d539e\007" # cursor
fi
# <<< theme-picker osc <<<
