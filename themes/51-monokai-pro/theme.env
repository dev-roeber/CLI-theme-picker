THEME_NAME="51-monokai-pro"
THEME_RANK="51"
THEME_BG="#2d2a2e"
THEME_FG="#fcfcfa"
THEME_ACCENT="#ff6188"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#fcfcfa\007"  # foreground
  printf "\033]11;#2d2a2e\007"  # background
  printf "\033]12;#ff6188\007" # cursor
fi
# <<< theme-picker osc <<<
