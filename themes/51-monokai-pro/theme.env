THEME_NAME="51-monokai-pro"
THEME_RANK="51"
THEME_BG="#2d2a2e"
THEME_FG="#fcfcfa"
THEME_ACCENT="#ff6188"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor + ANSI 16 colors via OSC.
# Honored by: iTerm2, Ghostty, kitty, alacritty, WezTerm, recent
# Terminal.app, gnome-terminal. Disable with THEME_PICKER_NO_OSC=1.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#fcfcfa\007"  # foreground
  printf "\033]11;#2d2a2e\007"  # background
  printf "\033]12;#ff6188\007" # cursor
  printf "\033]4;0;#403e41\007"
  printf "\033]4;1;#ff6188\007"
  printf "\033]4;2;#a9dc76\007"
  printf "\033]4;3;#ffd866\007"
  printf "\033]4;4;#fc9867\007"
  printf "\033]4;5;#ab9df2\007"
  printf "\033]4;6;#78dce8\007"
  printf "\033]4;7;#fcfcfa\007"
  printf "\033]4;8;#727072\007"
  printf "\033]4;9;#ff6188\007"
  printf "\033]4;10;#a9dc76\007"
  printf "\033]4;11;#ffd866\007"
  printf "\033]4;12;#fc9867\007"
  printf "\033]4;13;#ab9df2\007"
  printf "\033]4;14;#78dce8\007"
  printf "\033]4;15;#fcfcfa\007"
fi
# <<< theme-picker osc <<<
