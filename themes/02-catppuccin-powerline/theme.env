THEME_NAME="catppuccin-powerline"
THEME_RANK="02"
THEME_BG="#1e1e2e"
THEME_FG="#cdd6f4"
THEME_ACCENT="#89b4fa"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#cdd6f4\007"  # foreground
  printf "\033]11;#1e1e2e\007"  # background
  printf "\033]12;#89b4fa\007" # cursor
fi
# <<< theme-picker osc <<<
