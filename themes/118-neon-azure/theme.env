THEME_NAME="118-neon-azure"
THEME_RANK="118"
THEME_BG="#00081f"
THEME_FG="#1e90ff"
THEME_ACCENT="#007fff"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor + ANSI 16 colors via OSC.
# Honored by: iTerm2, Ghostty, kitty, alacritty, WezTerm, recent
# Terminal.app, gnome-terminal. Disable with THEME_PICKER_NO_OSC=1.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#1e90ff\007"  # foreground
  printf "\033]11;#00081f\007"  # background
  printf "\033]12;#007fff\007" # cursor
  printf "\033]4;0;#00081f\007"
  printf "\033]4;1;#f7768e\007"
  printf "\033]4;2;#9ece6a\007"
  printf "\033]4;3;#e0af68\007"
  printf "\033]4;4;#007fff\007"
  printf "\033]4;5;#00bfff\007"
  printf "\033]4;6;#7dcfff\007"
  printf "\033]4;7;#a9b1d6\007"
  printf "\033]4;8;#414868\007"
  printf "\033]4;9;#f7768e\007"
  printf "\033]4;10;#9ece6a\007"
  printf "\033]4;11;#e0af68\007"
  printf "\033]4;12;#007fff\007"
  printf "\033]4;13;#00bfff\007"
  printf "\033]4;14;#7dcfff\007"
  printf "\033]4;15;#1e90ff\007"
fi
# <<< theme-picker osc <<<
