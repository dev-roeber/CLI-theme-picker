THEME_NAME="118-neon-azure"
THEME_RANK="118"
THEME_BG="#00081f"
THEME_FG="#1e90ff"
THEME_ACCENT="#007fff"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#1e90ff\007"  # foreground
  printf "\033]11;#00081f\007"  # background
  printf "\033]12;#007fff\007" # cursor
fi
# <<< theme-picker osc <<<
