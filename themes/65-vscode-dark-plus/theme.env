THEME_NAME="65-vscode-dark-plus"
THEME_RANK="65"
THEME_BG="#1e1e1e"
THEME_FG="#d4d4d4"
THEME_ACCENT="#569cd6"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#d4d4d4\007"  # foreground
  printf "\033]11;#1e1e1e\007"  # background
  printf "\033]12;#569cd6\007" # cursor
fi
# <<< theme-picker osc <<<
