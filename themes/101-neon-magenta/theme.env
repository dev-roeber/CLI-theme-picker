THEME_NAME="101-neon-magenta"
THEME_RANK="101"
THEME_BG="#0a0014"
THEME_FG="#ff10f0"
THEME_ACCENT="#ff00ff"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#ff10f0\007"  # foreground
  printf "\033]11;#0a0014\007"  # background
  printf "\033]12;#ff00ff\007" # cursor
fi
# <<< theme-picker osc <<<
