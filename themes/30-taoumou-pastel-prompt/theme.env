THEME_NAME="taoumou-pastel-prompt"
THEME_RANK="30"
THEME_BG="#1f1f28"
THEME_FG="#dcd7ba"
THEME_ACCENT="#c8c093"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#dcd7ba\007"  # foreground
  printf "\033]11;#1f1f28\007"  # background
  printf "\033]12;#c8c093\007" # cursor
fi
# <<< theme-picker osc <<<
