THEME_NAME="91-jellybeans"
THEME_RANK="91"
THEME_BG="#151515"
THEME_FG="#e8e8d3"
THEME_ACCENT="#88b8f6"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#e8e8d3\007"  # foreground
  printf "\033]11;#151515\007"  # background
  printf "\033]12;#88b8f6\007" # cursor
fi
# <<< theme-picker osc <<<
