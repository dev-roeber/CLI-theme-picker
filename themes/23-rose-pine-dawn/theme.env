THEME_NAME="rose-pine-dawn"
THEME_RANK="23"
THEME_BG="#faf4ed"
THEME_FG="#575279"
THEME_ACCENT="#d7827e"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor + ANSI 16 colors via OSC.
# Honored by: iTerm2, Ghostty, kitty, alacritty, WezTerm, recent
# Terminal.app, gnome-terminal. Disable with THEME_PICKER_NO_OSC=1.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#575279\007"  # foreground
  printf "\033]11;#faf4ed\007"  # background
  printf "\033]12;#d7827e\007" # cursor
  printf "\033]4;0;#f2e9e1\007"
  printf "\033]4;1;#b4637a\007"
  printf "\033]4;2;#286983\007"
  printf "\033]4;3;#ea9d34\007"
  printf "\033]4;4;#56949f\007"
  printf "\033]4;5;#907aa9\007"
  printf "\033]4;6;#d7827e\007"
  printf "\033]4;7;#575279\007"
  printf "\033]4;8;#9893a5\007"
  printf "\033]4;9;#b4637a\007"
  printf "\033]4;10;#286983\007"
  printf "\033]4;11;#ea9d34\007"
  printf "\033]4;12;#56949f\007"
  printf "\033]4;13;#907aa9\007"
  printf "\033]4;14;#d7827e\007"
  printf "\033]4;15;#575279\007"
fi
# <<< theme-picker osc <<<
