THEME_NAME="rose-pine-dawn"
THEME_RANK="23"
THEME_BG="#faf4ed"
THEME_FG="#575279"
THEME_ACCENT="#d7827e"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#575279\007"  # foreground
  printf "\033]11;#faf4ed\007"  # background
  printf "\033]12;#d7827e\007" # cursor
fi
# <<< theme-picker osc <<<
