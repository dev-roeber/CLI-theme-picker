THEME_NAME="107-neon-blue"
THEME_RANK="107"
THEME_BG="#000014"
THEME_FG="#1f51ff"
THEME_ACCENT="#00bfff"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#1f51ff\007"  # foreground
  printf "\033]11;#000014\007"  # background
  printf "\033]12;#00bfff\007" # cursor
fi
# <<< theme-picker osc <<<
