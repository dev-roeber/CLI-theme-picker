THEME_NAME="95-seti"
THEME_RANK="95"
THEME_BG="#151718"
THEME_FG="#cfd2d1"
THEME_ACCENT="#55b5db"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#cfd2d1\007"  # foreground
  printf "\033]11;#151718\007"  # background
  printf "\033]12;#55b5db\007" # cursor
fi
# <<< theme-picker osc <<<
