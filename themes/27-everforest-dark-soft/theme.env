THEME_NAME="everforest-dark-soft"
THEME_RANK="27"
THEME_BG="#333c43"
THEME_FG="#d3c6aa"
THEME_ACCENT="#7fbbb3"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor + ANSI 16 colors via OSC.
# Honored by: iTerm2, Ghostty, kitty, alacritty, WezTerm, recent
# Terminal.app, gnome-terminal. Disable with THEME_PICKER_NO_OSC=1.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#d3c6aa\007"  # foreground
  printf "\033]11;#333c43\007"  # background
  printf "\033]12;#7fbbb3\007" # cursor
  printf "\033]4;0;#414b50\007"
  printf "\033]4;1;#e67e80\007"
  printf "\033]4;2;#a7c080\007"
  printf "\033]4;3;#dbbc7f\007"
  printf "\033]4;4;#7fbbb3\007"
  printf "\033]4;5;#d699b6\007"
  printf "\033]4;6;#83c092\007"
  printf "\033]4;7;#d3c6aa\007"
  printf "\033]4;8;#475258\007"
  printf "\033]4;9;#e67e80\007"
  printf "\033]4;10;#a7c080\007"
  printf "\033]4;11;#dbbc7f\007"
  printf "\033]4;12;#7fbbb3\007"
  printf "\033]4;13;#d699b6\007"
  printf "\033]4;14;#83c092\007"
  printf "\033]4;15;#d3c6aa\007"
fi
# <<< theme-picker osc <<<
