THEME_NAME="115-neon-emerald"
THEME_RANK="115"
THEME_BG="#001408"
THEME_FG="#00ff7f"
THEME_ACCENT="#50c878"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#00ff7f\007"  # foreground
  printf "\033]11;#001408\007"  # background
  printf "\033]12;#50c878\007" # cursor
fi
# <<< theme-picker osc <<<
