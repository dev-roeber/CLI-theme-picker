THEME_NAME="105-neon-orange"
THEME_RANK="105"
THEME_BG="#140a00"
THEME_FG="#ff7f00"
THEME_ACCENT="#ff6700"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#ff7f00\007"  # foreground
  printf "\033]11;#140a00\007"  # background
  printf "\033]12;#ff6700\007" # cursor
fi
# <<< theme-picker osc <<<
