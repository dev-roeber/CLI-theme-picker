THEME_NAME="94-twilight"
THEME_RANK="94"
THEME_BG="#141414"
THEME_FG="#e0e0e0"
THEME_ACCENT="#ce6700"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#e0e0e0\007"  # foreground
  printf "\033]11;#141414\007"  # background
  printf "\033]12;#ce6700\007" # cursor
fi
# <<< theme-picker osc <<<
