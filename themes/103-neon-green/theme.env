THEME_NAME="103-neon-green"
THEME_RANK="103"
THEME_BG="#001400"
THEME_FG="#39ff14"
THEME_ACCENT="#00ff41"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#39ff14\007"  # foreground
  printf "\033]11;#001400\007"  # background
  printf "\033]12;#00ff41\007" # cursor
fi
# <<< theme-picker osc <<<
