# delta theme — included via [include] path = ~/.config/theme-picker/active/delta.gitconfig
[delta]
  syntax-theme = OneHalfLight
  line-numbers = true
  navigate = true
  side-by-side = false
  file-style = "#0451a5 bold"
  hunk-header-decoration-style = "#0451a5 ul"
  file-decoration-style = "#0451a5"
  minus-style = "syntax #f7768e33"
  minus-emph-style = "syntax #f7768e55"
  plus-style = "syntax #9ece6a33"
  plus-emph-style = "syntax #9ece6a55"
  zero-style = "syntax"
  whitespace-error-style = "#f7768e reverse"
