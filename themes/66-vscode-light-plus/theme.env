THEME_NAME="66-vscode-light-plus"
THEME_RANK="66"
THEME_BG="#ffffff"
THEME_FG="#000000"
THEME_ACCENT="#0451a5"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#000000\007"  # foreground
  printf "\033]11;#ffffff\007"  # background
  printf "\033]12;#0451a5\007" # cursor
fi
# <<< theme-picker osc <<<
