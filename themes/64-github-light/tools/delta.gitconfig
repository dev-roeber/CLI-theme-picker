# delta theme — included via [include] path = ~/.config/theme-picker/active/delta.gitconfig
[delta]
  syntax-theme = GitHub
  line-numbers = true
  navigate = true
  side-by-side = false
  file-style = "#0969da bold"
  hunk-header-decoration-style = "#0969da ul"
  file-decoration-style = "#0969da"
  minus-style = "syntax #cf222e33"
  minus-emph-style = "syntax #cf222e55"
  plus-style = "syntax #11632933"
  plus-emph-style = "syntax #11632955"
  zero-style = "syntax"
  whitespace-error-style = "#cf222e reverse"
