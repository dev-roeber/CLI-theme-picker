THEME_NAME="64-github-light"
THEME_RANK="64"
THEME_BG="#ffffff"
THEME_FG="#24292f"
THEME_ACCENT="#0969da"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor + ANSI 16 colors via OSC.
# Honored by: iTerm2, Ghostty, kitty, alacritty, WezTerm, recent
# Terminal.app, gnome-terminal. Disable with THEME_PICKER_NO_OSC=1.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#24292f\007"  # foreground
  printf "\033]11;#ffffff\007"  # background
  printf "\033]12;#0969da\007" # cursor
  printf "\033]4;0;#24292f\007"
  printf "\033]4;1;#cf222e\007"
  printf "\033]4;2;#116329\007"
  printf "\033]4;3;#4d2d00\007"
  printf "\033]4;4;#0969da\007"
  printf "\033]4;5;#8250df\007"
  printf "\033]4;6;#1b7c83\007"
  printf "\033]4;7;#6e7781\007"
  printf "\033]4;8;#57606a\007"
  printf "\033]4;9;#a40e26\007"
  printf "\033]4;10;#1a7f37\007"
  printf "\033]4;11;#633c01\007"
  printf "\033]4;12;#218bff\007"
  printf "\033]4;13;#a475f9\007"
  printf "\033]4;14;#3192aa\007"
  printf "\033]4;15;#8c959f\007"
fi
# <<< theme-picker osc <<<
