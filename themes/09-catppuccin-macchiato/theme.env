THEME_NAME="catppuccin-macchiato"
THEME_RANK="09"
THEME_BG="#24273a"
THEME_FG="#cad3f5"
THEME_ACCENT="#c6a0f6"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#cad3f5\007"  # foreground
  printf "\033]11;#24273a\007"  # background
  printf "\033]12;#c6a0f6\007" # cursor
fi
# <<< theme-picker osc <<<
