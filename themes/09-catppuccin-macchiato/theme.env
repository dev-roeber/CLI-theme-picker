THEME_NAME="catppuccin-macchiato"
THEME_RANK="09"
THEME_BG="#24273a"
THEME_FG="#cad3f5"
THEME_ACCENT="#c6a0f6"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor + ANSI 16 colors via OSC.
# Honored by: iTerm2, Ghostty, kitty, alacritty, WezTerm, recent
# Terminal.app, gnome-terminal. Disable with THEME_PICKER_NO_OSC=1.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#cad3f5\007"  # foreground
  printf "\033]11;#24273a\007"  # background
  printf "\033]12;#c6a0f6\007" # cursor
  printf "\033]4;0;#494d64\007"
  printf "\033]4;1;#ed8796\007"
  printf "\033]4;2;#a6da95\007"
  printf "\033]4;3;#eed49f\007"
  printf "\033]4;4;#8aadf4\007"
  printf "\033]4;5;#f5bde6\007"
  printf "\033]4;6;#8bd5ca\007"
  printf "\033]4;7;#b8c0e0\007"
  printf "\033]4;8;#5b6078\007"
  printf "\033]4;9;#ed8796\007"
  printf "\033]4;10;#a6da95\007"
  printf "\033]4;11;#eed49f\007"
  printf "\033]4;12;#8aadf4\007"
  printf "\033]4;13;#f5bde6\007"
  printf "\033]4;14;#8bd5ca\007"
  printf "\033]4;15;#a5adcb\007"
fi
# <<< theme-picker osc <<<
