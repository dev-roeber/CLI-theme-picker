THEME_NAME="110-neon-lime"
THEME_RANK="110"
THEME_BG="#0a1400"
THEME_FG="#ccff00"
THEME_ACCENT="#bfff00"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#ccff00\007"  # foreground
  printf "\033]11;#0a1400\007"  # background
  printf "\033]12;#bfff00\007" # cursor
fi
# <<< theme-picker osc <<<
