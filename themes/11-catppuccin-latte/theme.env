THEME_NAME="catppuccin-latte"
THEME_RANK="11"
THEME_BG="#eff1f5"
THEME_FG="#4c4f69"
THEME_ACCENT="#8839ef"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor + ANSI 16 colors via OSC.
# Honored by: iTerm2, Ghostty, kitty, alacritty, WezTerm, recent
# Terminal.app, gnome-terminal. Disable with THEME_PICKER_NO_OSC=1.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#4c4f69\007"  # foreground
  printf "\033]11;#eff1f5\007"  # background
  printf "\033]12;#8839ef\007" # cursor
  printf "\033]4;0;#5c5f77\007"
  printf "\033]4;1;#d20f39\007"
  printf "\033]4;2;#40a02b\007"
  printf "\033]4;3;#df8e1d\007"
  printf "\033]4;4;#1e66f5\007"
  printf "\033]4;5;#ea76cb\007"
  printf "\033]4;6;#179299\007"
  printf "\033]4;7;#acb0be\007"
  printf "\033]4;8;#6c6f85\007"
  printf "\033]4;9;#d20f39\007"
  printf "\033]4;10;#40a02b\007"
  printf "\033]4;11;#df8e1d\007"
  printf "\033]4;12;#1e66f5\007"
  printf "\033]4;13;#ea76cb\007"
  printf "\033]4;14;#179299\007"
  printf "\033]4;15;#bcc0cc\007"
fi
# <<< theme-picker osc <<<
