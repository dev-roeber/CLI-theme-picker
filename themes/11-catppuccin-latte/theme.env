THEME_NAME="catppuccin-latte"
THEME_RANK="11"
THEME_BG="#eff1f5"
THEME_FG="#4c4f69"
THEME_ACCENT="#8839ef"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#4c4f69\007"  # foreground
  printf "\033]11;#eff1f5\007"  # background
  printf "\033]12;#8839ef\007" # cursor
fi
# <<< theme-picker osc <<<
