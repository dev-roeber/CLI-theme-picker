THEME_NAME="tokyo-night"
THEME_RANK="03"
THEME_BG="#1a1b26"
THEME_FG="#c0caf5"
THEME_ACCENT="#7aa2f7"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#c0caf5\007"  # foreground
  printf "\033]11;#1a1b26\007"  # background
  printf "\033]12;#7aa2f7\007" # cursor
fi
# <<< theme-picker osc <<<
