THEME_NAME="63-github-dark"
THEME_RANK="63"
THEME_BG="#0d1117"
THEME_FG="#c9d1d9"
THEME_ACCENT="#58a6ff"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor + ANSI 16 colors via OSC.
# Honored by: iTerm2, Ghostty, kitty, alacritty, WezTerm, recent
# Terminal.app, gnome-terminal. Disable with THEME_PICKER_NO_OSC=1.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#c9d1d9\007"  # foreground
  printf "\033]11;#0d1117\007"  # background
  printf "\033]12;#58a6ff\007" # cursor
  printf "\033]4;0;#484f58\007"
  printf "\033]4;1;#ff7b72\007"
  printf "\033]4;2;#3fb950\007"
  printf "\033]4;3;#d29922\007"
  printf "\033]4;4;#58a6ff\007"
  printf "\033]4;5;#bc8cff\007"
  printf "\033]4;6;#39c5cf\007"
  printf "\033]4;7;#b1bac4\007"
  printf "\033]4;8;#6e7681\007"
  printf "\033]4;9;#ffa198\007"
  printf "\033]4;10;#56d364\007"
  printf "\033]4;11;#e3b341\007"
  printf "\033]4;12;#79c0ff\007"
  printf "\033]4;13;#d2a8ff\007"
  printf "\033]4;14;#56d4dd\007"
  printf "\033]4;15;#f0f6fc\007"
fi
# <<< theme-picker osc <<<
