THEME_NAME="63-github-dark"
THEME_RANK="63"
THEME_BG="#0d1117"
THEME_FG="#c9d1d9"
THEME_ACCENT="#58a6ff"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#c9d1d9\007"  # foreground
  printf "\033]11;#0d1117\007"  # background
  printf "\033]12;#58a6ff\007" # cursor
fi
# <<< theme-picker osc <<<
