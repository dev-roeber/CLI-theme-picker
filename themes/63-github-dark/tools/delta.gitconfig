# delta theme — included via [include] path = ~/.config/theme-picker/active/delta.gitconfig
[delta]
  syntax-theme = TwoDark
  line-numbers = true
  navigate = true
  side-by-side = false
  file-style = "#58a6ff bold"
  hunk-header-decoration-style = "#58a6ff ul"
  file-decoration-style = "#58a6ff"
  minus-style = "syntax #ff7b7233"
  minus-emph-style = "syntax #ff7b7255"
  plus-style = "syntax #3fb95033"
  plus-emph-style = "syntax #3fb95055"
  zero-style = "syntax"
  whitespace-error-style = "#ff7b72 reverse"
