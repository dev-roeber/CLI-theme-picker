THEME_NAME="83-molokai"
THEME_RANK="83"
THEME_BG="#1b1d1e"
THEME_FG="#f8f8f2"
THEME_ACCENT="#f92672"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor + ANSI 16 colors via OSC.
# Honored by: iTerm2, Ghostty, kitty, alacritty, WezTerm, recent
# Terminal.app, gnome-terminal. Disable with THEME_PICKER_NO_OSC=1.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#f8f8f2\007"  # foreground
  printf "\033]11;#1b1d1e\007"  # background
  printf "\033]12;#f92672\007" # cursor
  printf "\033]4;0;#1b1d1e\007"
  printf "\033]4;1;#f92672\007"
  printf "\033]4;2;#a6e22e\007"
  printf "\033]4;3;#e6db74\007"
  printf "\033]4;4;#66d9ef\007"
  printf "\033]4;5;#ae81ff\007"
  printf "\033]4;6;#a1efe4\007"
  printf "\033]4;7;#f8f8f2\007"
  printf "\033]4;8;#75715e\007"
  printf "\033]4;9;#f92672\007"
  printf "\033]4;10;#a6e22e\007"
  printf "\033]4;11;#e6db74\007"
  printf "\033]4;12;#66d9ef\007"
  printf "\033]4;13;#ae81ff\007"
  printf "\033]4;14;#a1efe4\007"
  printf "\033]4;15;#f9f8f5\007"
fi
# <<< theme-picker osc <<<
