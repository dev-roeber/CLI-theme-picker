THEME_NAME="83-molokai"
THEME_RANK="83"
THEME_BG="#1b1d1e"
THEME_FG="#f8f8f2"
THEME_ACCENT="#f92672"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#f8f8f2\007"  # foreground
  printf "\033]11;#1b1d1e\007"  # background
  printf "\033]12;#f92672\007" # cursor
fi
# <<< theme-picker osc <<<
