THEME_NAME="fang2hou-gruvbox-rainbow"
THEME_RANK="39"
THEME_BG="#282828"
THEME_FG="#ebdbb2"
THEME_ACCENT="#fabd2f"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#ebdbb2\007"  # foreground
  printf "\033]11;#282828\007"  # background
  printf "\033]12;#fabd2f\007" # cursor
fi
# <<< theme-picker osc <<<
