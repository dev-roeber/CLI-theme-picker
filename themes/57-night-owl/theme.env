THEME_NAME="57-night-owl"
THEME_RANK="57"
THEME_BG="#011627"
THEME_FG="#d6deeb"
THEME_ACCENT="#82aaff"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#d6deeb\007"  # foreground
  printf "\033]11;#011627\007"  # background
  printf "\033]12;#82aaff\007" # cursor
fi
# <<< theme-picker osc <<<
