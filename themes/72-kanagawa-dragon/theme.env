THEME_NAME="72-kanagawa-dragon"
THEME_RANK="72"
THEME_BG="#181616"
THEME_FG="#c5c9c5"
THEME_ACCENT="#8ba4b0"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#c5c9c5\007"  # foreground
  printf "\033]11;#181616\007"  # background
  printf "\033]12;#8ba4b0\007" # cursor
fi
# <<< theme-picker osc <<<
