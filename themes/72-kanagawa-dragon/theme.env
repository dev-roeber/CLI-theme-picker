THEME_NAME="72-kanagawa-dragon"
THEME_RANK="72"
THEME_BG="#181616"
THEME_FG="#c5c9c5"
THEME_ACCENT="#8ba4b0"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor + ANSI 16 colors via OSC.
# Honored by: iTerm2, Ghostty, kitty, alacritty, WezTerm, recent
# Terminal.app, gnome-terminal. Disable with THEME_PICKER_NO_OSC=1.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#c5c9c5\007"  # foreground
  printf "\033]11;#181616\007"  # background
  printf "\033]12;#8ba4b0\007" # cursor
  printf "\033]4;0;#0d0c0c\007"
  printf "\033]4;1;#c4746e\007"
  printf "\033]4;2;#8a9a7b\007"
  printf "\033]4;3;#c4b28a\007"
  printf "\033]4;4;#8ba4b0\007"
  printf "\033]4;5;#a292a3\007"
  printf "\033]4;6;#8ea4a2\007"
  printf "\033]4;7;#c8c093\007"
  printf "\033]4;8;#a6a69c\007"
  printf "\033]4;9;#e46876\007"
  printf "\033]4;10;#87a987\007"
  printf "\033]4;11;#e6c384\007"
  printf "\033]4;12;#7fb4ca\007"
  printf "\033]4;13;#938aa9\007"
  printf "\033]4;14;#7aa89f\007"
  printf "\033]4;15;#c5c9c5\007"
fi
# <<< theme-picker osc <<<
