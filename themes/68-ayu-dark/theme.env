THEME_NAME="68-ayu-dark"
THEME_RANK="68"
THEME_BG="#0a0e14"
THEME_FG="#b3b1ad"
THEME_ACCENT="#e6b450"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor + ANSI 16 colors via OSC.
# Honored by: iTerm2, Ghostty, kitty, alacritty, WezTerm, recent
# Terminal.app, gnome-terminal. Disable with THEME_PICKER_NO_OSC=1.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#b3b1ad\007"  # foreground
  printf "\033]11;#0a0e14\007"  # background
  printf "\033]12;#e6b450\007" # cursor
  printf "\033]4;0;#01060e\007"
  printf "\033]4;1;#ea6c73\007"
  printf "\033]4;2;#7fd962\007"
  printf "\033]4;3;#f9af4f\007"
  printf "\033]4;4;#53bdfa\007"
  printf "\033]4;5;#cda1fa\007"
  printf "\033]4;6;#90e1c6\007"
  printf "\033]4;7;#c7c7c7\007"
  printf "\033]4;8;#686868\007"
  printf "\033]4;9;#f07178\007"
  printf "\033]4;10;#aad94c\007"
  printf "\033]4;11;#ffb454\007"
  printf "\033]4;12;#59c2ff\007"
  printf "\033]4;13;#d2a6ff\007"
  printf "\033]4;14;#95e6cb\007"
  printf "\033]4;15;#ffffff\007"
fi
# <<< theme-picker osc <<<
