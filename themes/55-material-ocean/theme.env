THEME_NAME="55-material-ocean"
THEME_RANK="55"
THEME_BG="#0f111a"
THEME_FG="#a6accd"
THEME_ACCENT="#80cbc4"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#a6accd\007"  # foreground
  printf "\033]11;#0f111a\007"  # background
  printf "\033]12;#80cbc4\007" # cursor
fi
# <<< theme-picker osc <<<
