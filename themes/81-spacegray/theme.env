THEME_NAME="81-spacegray"
THEME_RANK="81"
THEME_BG="#2b303b"
THEME_FG="#c0c5ce"
THEME_ACCENT="#bf616a"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#c0c5ce\007"  # foreground
  printf "\033]11;#2b303b\007"  # background
  printf "\033]12;#bf616a\007" # cursor
fi
# <<< theme-picker osc <<<
