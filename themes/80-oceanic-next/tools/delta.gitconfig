# delta theme — included via [include] path = ~/.config/theme-picker/active/delta.gitconfig
[delta]
  syntax-theme = Nord
  line-numbers = true
  navigate = true
  side-by-side = false
  file-style = "#6699cc bold"
  hunk-header-decoration-style = "#6699cc ul"
  file-decoration-style = "#6699cc"
  minus-style = "syntax #ec5f6733"
  minus-emph-style = "syntax #ec5f6755"
  plus-style = "syntax #99c79433"
  plus-emph-style = "syntax #99c79455"
  zero-style = "syntax"
  whitespace-error-style = "#ec5f67 reverse"
