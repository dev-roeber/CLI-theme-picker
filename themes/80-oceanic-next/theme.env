THEME_NAME="80-oceanic-next"
THEME_RANK="80"
THEME_BG="#1b2b34"
THEME_FG="#d8dee9"
THEME_ACCENT="#6699cc"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor + ANSI 16 colors via OSC.
# Honored by: iTerm2, Ghostty, kitty, alacritty, WezTerm, recent
# Terminal.app, gnome-terminal. Disable with THEME_PICKER_NO_OSC=1.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#d8dee9\007"  # foreground
  printf "\033]11;#1b2b34\007"  # background
  printf "\033]12;#6699cc\007" # cursor
  printf "\033]4;0;#1b2b34\007"
  printf "\033]4;1;#ec5f67\007"
  printf "\033]4;2;#99c794\007"
  printf "\033]4;3;#fac863\007"
  printf "\033]4;4;#6699cc\007"
  printf "\033]4;5;#c594c5\007"
  printf "\033]4;6;#5fb3b3\007"
  printf "\033]4;7;#d8dee9\007"
  printf "\033]4;8;#65737e\007"
  printf "\033]4;9;#ec5f67\007"
  printf "\033]4;10;#99c794\007"
  printf "\033]4;11;#fac863\007"
  printf "\033]4;12;#6699cc\007"
  printf "\033]4;13;#c594c5\007"
  printf "\033]4;14;#5fb3b3\007"
  printf "\033]4;15;#d8dee9\007"
fi
# <<< theme-picker osc <<<
