# delta theme — included via [include] path = ~/.config/theme-picker/active/delta.gitconfig
[delta]
  syntax-theme = gruvbox-dark
  line-numbers = true
  navigate = true
  side-by-side = false
  file-style = "#83a598 bold"
  hunk-header-decoration-style = "#83a598 ul"
  file-decoration-style = "#83a598"
  minus-style = "syntax #cc241d33"
  minus-emph-style = "syntax #cc241d55"
  plus-style = "syntax #98971a33"
  plus-emph-style = "syntax #98971a55"
  zero-style = "syntax"
  whitespace-error-style = "#cc241d reverse"
