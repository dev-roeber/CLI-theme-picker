THEME_NAME="everforest-starship"
THEME_RANK="13"
THEME_BG="#2d353b"
THEME_FG="#d3c6aa"
THEME_ACCENT="#a7c080"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#d3c6aa\007"  # foreground
  printf "\033]11;#2d353b\007"  # background
  printf "\033]12;#a7c080\007" # cursor
fi
# <<< theme-picker osc <<<
