THEME_NAME="nordic-pastel-powerline"
THEME_RANK="29"
THEME_BG="#3b4252"
THEME_FG="#e5e9f0"
THEME_ACCENT="#a3be8c"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#e5e9f0\007"  # foreground
  printf "\033]11;#3b4252\007"  # background
  printf "\033]12;#a3be8c\007" # cursor
fi
# <<< theme-picker osc <<<
