THEME_NAME="71-kanagawa-wave"
THEME_RANK="71"
THEME_BG="#1f1f28"
THEME_FG="#dcd7ba"
THEME_ACCENT="#7e9cd8"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor + ANSI 16 colors via OSC.
# Honored by: iTerm2, Ghostty, kitty, alacritty, WezTerm, recent
# Terminal.app, gnome-terminal. Disable with THEME_PICKER_NO_OSC=1.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#dcd7ba\007"  # foreground
  printf "\033]11;#1f1f28\007"  # background
  printf "\033]12;#7e9cd8\007" # cursor
  printf "\033]4;0;#16161d\007"
  printf "\033]4;1;#c34043\007"
  printf "\033]4;2;#76946a\007"
  printf "\033]4;3;#c0a36e\007"
  printf "\033]4;4;#7e9cd8\007"
  printf "\033]4;5;#957fb8\007"
  printf "\033]4;6;#6a9589\007"
  printf "\033]4;7;#c8c093\007"
  printf "\033]4;8;#727169\007"
  printf "\033]4;9;#e82424\007"
  printf "\033]4;10;#98bb6c\007"
  printf "\033]4;11;#e6c384\007"
  printf "\033]4;12;#7fb4ca\007"
  printf "\033]4;13;#938aa9\007"
  printf "\033]4;14;#7aa89f\007"
  printf "\033]4;15;#dcd7ba\007"
fi
# <<< theme-picker osc <<<
