THEME_NAME="gruvbox-rainbow"
THEME_RANK="05"
THEME_BG="#282828"
THEME_FG="#ebdbb2"
THEME_ACCENT="#fabd2f"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor + ANSI 16 colors via OSC.
# Honored by: iTerm2, Ghostty, kitty, alacritty, WezTerm, recent
# Terminal.app, gnome-terminal. Disable with THEME_PICKER_NO_OSC=1.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#ebdbb2\007"  # foreground
  printf "\033]11;#282828\007"  # background
  printf "\033]12;#fabd2f\007" # cursor
  printf "\033]4;0;#282828\007"
  printf "\033]4;1;#cc241d\007"
  printf "\033]4;2;#98971a\007"
  printf "\033]4;3;#d79921\007"
  printf "\033]4;4;#458588\007"
  printf "\033]4;5;#b16286\007"
  printf "\033]4;6;#689d6a\007"
  printf "\033]4;7;#a89984\007"
  printf "\033]4;8;#928374\007"
  printf "\033]4;9;#fb4934\007"
  printf "\033]4;10;#b8bb26\007"
  printf "\033]4;11;#fabd2f\007"
  printf "\033]4;12;#83a598\007"
  printf "\033]4;13;#d3869b\007"
  printf "\033]4;14;#8ec07c\007"
  printf "\033]4;15;#ebdbb2\007"
fi
# <<< theme-picker osc <<<
