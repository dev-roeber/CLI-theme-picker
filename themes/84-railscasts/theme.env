THEME_NAME="84-railscasts"
THEME_RANK="84"
THEME_BG="#2b2b2b"
THEME_FG="#e6e1dc"
THEME_ACCENT="#cc7833"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#e6e1dc\007"  # foreground
  printf "\033]11;#2b2b2b\007"  # background
  printf "\033]12;#cc7833\007" # cursor
fi
# <<< theme-picker osc <<<
