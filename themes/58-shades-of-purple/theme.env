THEME_NAME="58-shades-of-purple"
THEME_RANK="58"
THEME_BG="#2d2b55"
THEME_FG="#ffffff"
THEME_ACCENT="#a599e9"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#ffffff\007"  # foreground
  printf "\033]11;#2d2b55\007"  # background
  printf "\033]12;#a599e9\007" # cursor
fi
# <<< theme-picker osc <<<
