THEME_NAME="99-mariana"
THEME_RANK="99"
THEME_BG="#343d46"
THEME_FG="#d8dee9"
THEME_ACCENT="#5fb3b3"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#d8dee9\007"  # foreground
  printf "\033]11;#343d46\007"  # background
  printf "\033]12;#5fb3b3\007" # cursor
fi
# <<< theme-picker osc <<<
