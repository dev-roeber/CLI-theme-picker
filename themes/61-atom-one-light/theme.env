THEME_NAME="61-atom-one-light"
THEME_RANK="61"
THEME_BG="#fafafa"
THEME_FG="#383a42"
THEME_ACCENT="#4078f2"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor + ANSI 16 colors via OSC.
# Honored by: iTerm2, Ghostty, kitty, alacritty, WezTerm, recent
# Terminal.app, gnome-terminal. Disable with THEME_PICKER_NO_OSC=1.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#383a42\007"  # foreground
  printf "\033]11;#fafafa\007"  # background
  printf "\033]12;#4078f2\007" # cursor
  printf "\033]4;0;#000000\007"
  printf "\033]4;1;#e45649\007"
  printf "\033]4;2;#50a14f\007"
  printf "\033]4;3;#c18401\007"
  printf "\033]4;4;#4078f2\007"
  printf "\033]4;5;#a626a4\007"
  printf "\033]4;6;#0184bc\007"
  printf "\033]4;7;#a0a1a7\007"
  printf "\033]4;8;#383a42\007"
  printf "\033]4;9;#e45649\007"
  printf "\033]4;10;#50a14f\007"
  printf "\033]4;11;#c18401\007"
  printf "\033]4;12;#4078f2\007"
  printf "\033]4;13;#a626a4\007"
  printf "\033]4;14;#0184bc\007"
  printf "\033]4;15;#383a42\007"
fi
# <<< theme-picker osc <<<
