THEME_NAME="catppuccin-mocha"
THEME_RANK="01"
THEME_BG="#1e1e2e"
THEME_FG="#cdd6f4"
THEME_ACCENT="#cba6f7"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor + ANSI 16 colors via OSC.
# Honored by: iTerm2, Ghostty, kitty, alacritty, WezTerm, recent
# Terminal.app, gnome-terminal. Disable with THEME_PICKER_NO_OSC=1.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#cdd6f4\007"  # foreground
  printf "\033]11;#1e1e2e\007"  # background
  printf "\033]12;#cba6f7\007" # cursor
  printf "\033]4;0;#45475a\007"
  printf "\033]4;1;#f38ba8\007"
  printf "\033]4;2;#a6e3a1\007"
  printf "\033]4;3;#f9e2af\007"
  printf "\033]4;4;#89b4fa\007"
  printf "\033]4;5;#f5c2e7\007"
  printf "\033]4;6;#94e2d5\007"
  printf "\033]4;7;#bac2de\007"
  printf "\033]4;8;#585b70\007"
  printf "\033]4;9;#f38ba8\007"
  printf "\033]4;10;#a6e3a1\007"
  printf "\033]4;11;#f9e2af\007"
  printf "\033]4;12;#89b4fa\007"
  printf "\033]4;13;#f5c2e7\007"
  printf "\033]4;14;#94e2d5\007"
  printf "\033]4;15;#a6adc8\007"
fi
# <<< theme-picker osc <<<
