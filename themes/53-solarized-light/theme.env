THEME_NAME="53-solarized-light"
THEME_RANK="53"
THEME_BG="#fdf6e3"
THEME_FG="#657b83"
THEME_ACCENT="#268bd2"

# >>> theme-picker osc >>>
# Sends terminal foreground/background/cursor color via OSC sequences.
# Most modern terminals honor this (iTerm2, Ghostty, kitty, alacritty,
# WezTerm, recent Terminal.app). No-op when not on a TTY.
if [ -t 1 ] && [ -z "${THEME_PICKER_NO_OSC:-}" ]; then
  printf "\033]10;#657b83\007"  # foreground
  printf "\033]11;#fdf6e3\007"  # background
  printf "\033]12;#268bd2\007" # cursor
fi
# <<< theme-picker osc <<<
